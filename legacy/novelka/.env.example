# ============================================================================
# Novelka client build-time environment.
#
# Copy to .env and fill in. NEVER commit .env (it is gitignored at every
# depth). The server secrets live in server/.env — see server/.env.example.
#
# Without these, the app runs in fully local mode: the auth mock, local
# entitlement and simulated upgrades. Nothing breaks; there is just no real
# account, quota or payment layer.
# ============================================================================

# ---- Supabase (Project Settings → API) -------------------------------------
# Public anon key — safe in the browser by design (RLS protects the data).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---- Novelka API ----------------------------------------------------------
# Where the server lives. Empty = same origin (the dev server proxies /api).
VITE_API_BASE=

# ---- Admin panel ------------------------------------------------------------
# Set to false for public builds: the admin panel is then stripped from the
# bundle entirely, not merely hidden.
# VITE_ENABLE_ADMIN=false
