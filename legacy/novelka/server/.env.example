# ============================================================================
# Novelka server secrets.
#
# Copy to server/.env and fill in. NEVER commit .env (it is gitignored at every
# depth). NEVER put any of these in src/ — that is the browser bundle.
# Run `npm run verify:secrets` before deploying; it fails the build on a leak.
# ============================================================================

# ---- Supabase (Project Settings → API) -------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role BYPASSES Row Level Security. Server only. Never in a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated secret for HMAC-SHA256 entitlement grant token signing (at least 32 characters,
# preferably 32 random bytes encoded as 64 hex characters: openssl rand -hex 32).
# MUST NOT be identical to SUPABASE_SERVICE_ROLE_KEY or SUPABASE_ANON_KEY. Server only.
GRANT_SIGNING_SECRET=

# ---- Stripe (Developers → API keys) ----------------------------------------
# Starts sk_test_… while testing, sk_live_… in production.
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → "Signing secret" (whsec_…).
# Without this, anyone could POST a fake "payment succeeded".
STRIPE_WEBHOOK_SECRET=

# ---- Stripe price IDs (Products → your product → Pricing) ------------------
# The server maps tier name → price. The client never sends an amount.
STRIPE_PRICE_BASIC=price_
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_ENTERPRISE=price_

# ---- App --------------------------------------------------------------------
APP_URL=https://your-domain.example
