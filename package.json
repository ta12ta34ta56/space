{
  "name": "novelka",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --disable-nested-config --deny-warnings",
    "test": "npm run test:units && npm run test:document",
    "test:units": "esbuild src/model/units.ts --bundle --format=esm --platform=node --packages=external --outfile=src/model/units.built.mjs --log-level=error && node src/model/units.test.mjs",
    "test:document": "esbuild src/model/index.ts --bundle --format=esm --platform=node --packages=external --outfile=src/model/model.built.mjs --log-level=error && node src/model/document.test.mjs",
    "check": "npm run lint && tsc -b && npm run test && npm run build"
  },
  "dependencies": {
    "nanoid": "^5.1.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
